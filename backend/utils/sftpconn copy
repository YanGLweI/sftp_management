package utils

import (
	"fmt"
	"mime/multipart"
	"path/filepath"
	"sftpbackend/config"

	"github.com/pkg/sftp"
	"golang.org/x/crypto/ssh"
)

// 全局SFTP客户端
var SftpClient *sftp.Client

// 全局SSH客户端
var SSHClient *ssh.Client

// ! 初始化SFTP连接
func InitSFTP(user, password string) error {
	conf := config.GlobalConfig.SFTP
	sshConfig := &ssh.ClientConfig{
		User:            user,
		Auth:            []ssh.AuthMethod{ssh.Password(password)},
		HostKeyCallback: ssh.InsecureIgnoreHostKey(),
	}
	// 连接ssh服务器
	SSHClient, err := ssh.Dial("tcp", conf.Host+":"+fmt.Sprint(conf.Port), sshConfig)
	if err != nil {
		return err
	}
	// 创建SFTP客户端
	SftpClient, err = sftp.NewClient(SSHClient)
	if err != nil {
		return err
	}
	return nil
}

// ! 密钥登录SFTP
func InitSFTPByKey(user string, key []byte) error {
	conf := config.GlobalConfig.SFTP
	signer, err := ssh.ParsePrivateKey(key)
	if err != nil {
		return err
	}
	sshConfig := &ssh.ClientConfig{
		User:            user,
		Auth:            []ssh.AuthMethod{ssh.PublicKeys(signer)},
		HostKeyCallback: ssh.InsecureIgnoreHostKey(),
	}
	// 连接ssh服务器
	SSHClient, err := ssh.Dial("tcp", conf.Host+":"+fmt.Sprint(conf.Port), sshConfig)
	if err != nil {
		return err
	}
	// 创建SFTP客户端
	SftpClient, err = sftp.NewClient(SSHClient)
	if err != nil {
		return err
	}
	return nil
}

// ! 断开SFTP连接
func CloseSFTP() error {
	if SftpClient != nil {
		if err := SftpClient.Close(); err != nil {
			return err
		}
		SftpClient = nil
	}

	if SSHClient != nil {
		conn := SSHClient.Conn
		conn.Close()
		// 关闭SSH连接
		if err := SSHClient.Close(); err != nil {
			return err
		}
		SSHClient = nil
	}
	return nil
}

// ! 创建上传的文件
func CreateUploadFile(dstPath string, srcFile multipart.File) error {
	if SftpClient == nil {
		return fmt.Errorf("SFTP初始化失败，请先登录")
	}

	// 创建文件
	dstFile, err := SftpClient.Create(dstPath)
	if err != nil {
		return err
	}
	defer dstFile.Close()

	// 复制文件内容
	if _, err := dstFile.ReadFrom(srcFile); err != nil {
		return err
	}
	return nil
}

// ! 创建目录
func CreateFolder(path, folderName string) error {
	if SftpClient == nil {
		return fmt.Errorf("SFTP未连接，请先登录")
	}

	// 拼接目录路径
	fullPath := filepath.Join(path, folderName)

	// 创建目录
	if err := SftpClient.Mkdir(fullPath); err != nil {
		return fmt.Errorf("创建目录失败: %v", err)
	}
	return nil
}

// ! 递归删除
func DeleteDirectory(path string) error {
	files, err := SftpClient.ReadDir(path)
	if err != nil {
		return err
	}

	for _, file := range files {
		filePath := filepath.Join(path, file.Name())
		if file.IsDir() {
			if err := DeleteDirectory(filePath); err != nil {
				return err
			}
		} else {
			if err := SftpClient.Remove(filePath); err != nil {
				return err
			}
		}
	}

	return SftpClient.RemoveDirectory(path)
}
